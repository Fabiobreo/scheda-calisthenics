# Copia in .env.local. Senza questi valori l'app non parte.
# Sviluppo: i valori del Supabase locale, stampati da `npx supabase start` (API URL e anon/publishable key).
# Produzione: quelli del progetto su supabase.com (Project Settings → API), come variabili di Vercel.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Facoltativa: email del supporto mostrata in Account → Informazioni. Senza, la voce non compare.
# VITE_SUPPORT_EMAIL=supporto@example.com
